{
  "manifest_version": 3,
  "name": "Sloppycat",
  "version": "0.4.0",
  "description": "Watches your artist or author profiles for releases you did not publish, writes the takedown, and marks fakes for listeners.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://open.spotify.com/*",
    "https://api-partner.spotify.com/*",
    "https://music.apple.com/*",
    "https://itunes.apple.com/*",
    "https://api.deezer.com/*",
    "https://www.googleapis.com/*",
    "https://www.amazon.com/stores/*",
    "https://www.amazon.com/s*",
    "https://www.amazon.co.uk/stores/*",
    "https://www.amazon.co.uk/s*",
    "https://www.amazon.ca/stores/*",
    "https://www.amazon.ca/s*",
    "https://www.amazon.de/stores/*",
    "https://www.amazon.de/s*",
    "https://www.goodreads.com/author/*",
    "https://www.goodreads.com/search*",
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*",
    "https://gist.github.com/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "ui/popup/index.html",
    "default_title": "Sloppycat"
  },
  "options_page": "ui/options/index.html",
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content/spotify-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://open.spotify.com/*",
        "https://music.apple.com/*",
        "https://www.amazon.com/stores/*",
        "https://www.amazon.com/dp/*",
        "https://www.amazon.com/gp/product/*",
        "https://www.amazon.com/*/e/*",
        "https://www.amazon.co.uk/stores/*",
        "https://www.amazon.co.uk/dp/*",
        "https://www.amazon.co.uk/gp/product/*",
        "https://www.amazon.co.uk/*/e/*",
        "https://www.amazon.ca/stores/*",
        "https://www.amazon.ca/dp/*",
        "https://www.amazon.ca/gp/product/*",
        "https://www.amazon.ca/*/e/*",
        "https://www.amazon.de/stores/*",
        "https://www.amazon.de/dp/*",
        "https://www.amazon.de/gp/product/*",
        "https://www.amazon.de/*/e/*",
        "https://www.goodreads.com/author/*",
        "https://www.goodreads.com/book/*"
      ],
      "js": [
        "content/overlay.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lists/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
